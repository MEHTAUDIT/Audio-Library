{
  "name": "audio-library-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Audio Library",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy \"AudioLibrary-Development-*\" --require-approval never",
    "deploy:staging": "cdk deploy \"AudioLibrary-Staging-*\" --require-approval never",
    "deploy:prod": "cdk deploy \"AudioLibrary-Production-*\"",
    "destroy:dev": "cdk destroy \"AudioLibrary-Development-*\"",
    "diff": "cdk diff",
    "synth": "cdk synth"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "~5.3.0",
    "aws-cdk": "^2.120.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0",
    "js-yaml": "^4.1.0",
    "source-map-support": "^0.5.21"
  }
}

